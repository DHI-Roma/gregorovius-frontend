    "vue": "^3.5.42",
    "vue-image-zoomer": "^2.4.4",
    "vue-matomo": "^4.2.0",
    "vue-router": "^4.2.5",
    "vue3-runtime-template": "^1.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@quasar/app-vite": "^2.6.2",
    "@vue/test-utils": "^2.4.4",
    "autoprefixer": "^10.4.17",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.2.5",
    "sass": "^1.70.0",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.22.0 || ^24",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
