{
  "name": "gregorovius-frontend",
  "version": "2.0.1",
  "description": "Gregorovius Briefedition Frontend",
  "productName": "Gregorovius Briefedition",
  "private": true,
  "imports": {
    "#q-app": "@quasar/app-vite",
    "#q-app/*": "@quasar/app-vite/*"
  },
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "lint": "eslint ./src",
