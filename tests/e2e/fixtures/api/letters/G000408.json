  "profileDesc": {
   "abstract": {
    "p": [
     {
      "@xml:lang": "de",
      "#text": "Er sendet ihm den zweiten Band seiner „Geschichte der Stadt Rom im Mittelalter“ (1859). Aufgrund einer verlorenen Buchsendung kann er den ersten Band (1859) nicht beilegen. Der dritte Band (1860) soll im kommenden Frühjahr erscheinen."
     },
     {
      "@xml:lang": "en",
      "#text": "He sends him the second volume of his „Geschichte der Stadt Rom im Mittelalter“ (1859). Due to a lost shipment of books he cannot enclose the first volume (1859). The third volume (1860) is to be published next spring."
     }
    ]
   },
