  "profileDesc": {
   "abstract": {
    "p": [
     {
      "@xml:lang": "de",
      "#text": "Er übersendet das Manuskript seines „Corsica“ (1854) und erläutert ausführlich seinen Inhalt und die Form. Er hofft auf die Verlagsübernahme und bittet um baldmöglichste Entscheidung."
     },
     {
      "@xml:lang": "en",
      "#text": "He sends his manuscript of „Corsica“ (1854) and explains its content and form in great detail. He hopes the publisher will accept his offer and asks for a decision as soon as possible."
     }
    ]
   },
